# JARVIS OS — Environment Configuration
# Copy to .env and fill in your values
# All keys are OPTIONAL — JARVIS runs in simulation mode without them.

# ─── AI Providers ──────────────────────────────────────────────────────────────
# Google Gemini (recommended — fast, capable, generous free tier)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# OpenAI (optional — fallback to gpt-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (optional — fallback to claude-3-haiku)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI-compatible endpoints (Groq, Together AI, local vLLM, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-key-here

# ─── JARVIS Config ─────────────────────────────────────────────────────────────
JARVIS_HOME=/home/pi/jarvis-os
JARVIS_SIMULATION=true
JARVIS_SECRET_KEY=change-this-to-a-random-string
JARVIS_DB_PATH=/home/pi/jarvis-os/jarvis_memory.db
JARVIS_AUDIT_LOG=/var/log/jarvis/audit.log

# ─── Hardware (advanced) ───────────────────────────────────────────────────────
# ESP32_SERIAL_PORT=/dev/ttyUSB0
# CAMERA_ENABLED=false
