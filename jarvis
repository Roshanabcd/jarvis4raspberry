#!/usr/bin/env bash
# JARVIS OS Universal Desktop & CLI Launcher

PROJECT_DIR="/home/roshan/.gemini/antigravity/scratch/jarvis-os"
PYTHON_EXEC="/home/roshan/miniconda3/bin/python3"

export DISPLAY="${DISPLAY:-:0}"
export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH}"

if [ "$1" = "cli" ]; then
    shift
    exec "${PYTHON_EXEC}" "${PROJECT_DIR}/apps/terminal/cli.py" "$@"
elif [ "$1" = "--cli" ]; then
    shift
    exec "${PYTHON_EXEC}" "${PROJECT_DIR}/apps/terminal/cli.py" "$@"
else
    exec "${PYTHON_EXEC}" "${PROJECT_DIR}/apps/desktop/launcher.py" "$@"
fi
