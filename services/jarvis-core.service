[Unit]
Description=JARVIS OS Core Service — AI Operating Environment
Documentation=https://github.com/your-user/jarvis-os
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=roshan
WorkingDirectory=/home/roshan/.gemini/antigravity/scratch/jarvis-os
ExecStart=/home/roshan/.gemini/antigravity/scratch/jarvis-os/venv/bin/python -m uvicorn apps.core.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info \
    --access-log
Environment=PYTHONPATH=/home/roshan/.gemini/antigravity/scratch/jarvis-os
Environment=JARVIS_HOME=/home/roshan/.gemini/antigravity/scratch/jarvis-os
Environment=JARVIS_SIMULATION=true
Environment=DISPLAY=:0
EnvironmentFile=-/home/roshan/.gemini/antigravity/scratch/jarvis-os/.env
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-core

# Security hardening
NoNewPrivileges=yes
PrivateTmp=false

[Install]
WantedBy=multi-user.target
